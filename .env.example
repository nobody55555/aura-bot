# Safe default; choose backtest, paper, or live
AURA_MODE=paper
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
POLL_SECONDS=300

# Required only for an eventual venue-specific live adapter
BINANCE_API_KEY=
BINANCE_SECRET=

# Optional explanation layer; never required for the primary signal
ENABLE_LLM=false
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
LLM_MODEL=

# Risk defaults
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.25
DAILY_LOSS_LIMIT=0.03
MAX_DRAWDOWN=0.15
TRAILING_ATR=2.0

# --- Alerting (e-mail) ---
# Leave empty to disable e-mail alerts (they will only be logged)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true

# --- IRC (placeholder only – not implemented) ---
# IRC_SERVER=
# IRC_PORT=6667
# IRC_CHANNEL=
# IRC_NICK=
# IRC_PASSWORD=
